@startuml
title DER conceptual — Sistema de Gestión Rojas FC

left to right direction

hide methods
hide stereotypes
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 120
skinparam ArrowColor #444444
skinparam NoteBackgroundColor #FFFDEB
skinparam NoteBorderColor #888888

legend top right
  <u>Subrayado</u>: identificador
  {parcial}: identificador parcial de entidad débil
  /Atributo: derivado (se calcula)
  [opcional]: puede no tener valor
  Sin subrayado: identificador a definir en la etapa de claves (#13)
  Cardinalidad: el número junto a una entidad indica
  cuántas ocurrencias de esa entidad se vinculan
  con una ocurrencia de la entidad del otro extremo.
end legend

' ===================== Personas =====================

entity "Persona" as Persona {
  <u>DNI</u>
  Nombre
  Apellido
}

entity "Alumno" as Alumno {
  Fecha de nacimiento
  Dirección: Domicilio, Barrio, Localidad
  Colegio
  Importe de cuota particular [opcional]
  /Categoría
  /Estado
  /Moroso
}

entity "Responsable" as Responsable {
  Teléfono
  Contraseña [opcional]
}

entity "Personal Administrativo" as Personal {
  Contraseña
}

Persona <|-- Alumno
Persona <|-- Responsable
Persona <|-- Personal

note top of Persona
  Especialización TOTAL y EXCLUSIVA:
  Alumno | Responsable | Personal Administrativo.
  Responsable y Personal Administrativo ingresan con DNI + contraseña.
  Alumno no posee acceso al sistema.
end note

entity "Tipo de Vínculo" as TipoVinculo {
  <u>Nombre</u>
}

diamond TIENE
Alumno "1..N" -- TIENE
Responsable "1..2" -- TIENE
TipoVinculo "1" -- TIENE

note bottom of TIENE
  tiene como responsable (ternaria):
  cada Alumno tiene 1 a 2 Responsables,
  cada Responsable tiene 1 a N Alumnos y
  cada par Alumno–Responsable tiene 1 Tipo de Vínculo.
end note

' ===================== Inscripción y movimientos =====================

entity "Preinscripción" as Preinscripcion {
  Fecha
  == Datos del alumno ==
  Nombre
  Apellido
  DNI
  Fecha de nacimiento
  Domicilio
  Barrio
  Localidad
  Colegio
}

entity "Responsable declarado\n(entidad débil)" as RespDeclarado {
  DNI {parcial}
  Nombre
  Apellido
  Teléfono
}

entity "Movimiento de Alumno\n(entidad débil)" as Movimiento {
  Fecha y hora {parcial}
  Observación [opcional]
}

entity "Tipo de Movimiento" as TipoMovimiento {
  <u>Nombre</u>
}

Preinscripcion "1" -- "1..2" RespDeclarado : declara
TipoVinculo "1" -- "0..N" RespDeclarado : indica vínculo
Alumno "1" -- "1..N" Movimiento : registra\nmovimiento
Personal "1" -- "0..N" Movimiento : realiza
TipoMovimiento "1" -- "0..N" Movimiento : clasifica
note bottom of Preinscripcion
  Solicitud pendiente de revisión.
  Al aceptarse, sus datos pasan a Persona,
  Alumno y Responsable, y se elimina.
  Al rechazarse, se elimina.
  La identificación de Preinscripción y de
  Responsable declarado se resolverá en #13.
end note

' ===================== Obligaciones =====================

entity "Obligación de Pago" as Obligacion {
  Importe
  /Saldo
}

entity "Cuota" as Cuota {
  Recargo por mora [opcional]
  /Estado
}

entity "Matrícula" as Matricula {
  /Fecha de matriculación
}

entity "Cobro Extraordinario" as Cobro {
  Fecha de generación
}

entity "Cobro de Indumentaria" as Indumentaria {
  Tipo de prenda
  Talle
}

Obligacion <|-- Cuota
Obligacion <|-- Matricula
Obligacion <|-- Cobro
Cobro <|-- Indumentaria

note top of Obligacion
  Especialización TOTAL y EXCLUSIVA:
  Cuota | Matrícula | Cobro Extraordinario.
end note

note bottom of Cobro
  Especialización PARCIAL: Cobro de Indumentaria.
  Todo Cobro Extraordinario corresponde a un Evento
  o es de Indumentaria, nunca ambos ni ninguno.
end note

Alumno "1" -- "0..N" Obligacion : posee
Movimiento "1" -- "0..1" Matricula : origina

entity "Configuración de Cuota" as Configuracion {
  <u>Vigente desde</u>
  Importe general
  Porcentaje de interés
}

entity "Período de Cuota" as Periodo {
  <u>Período</u>
  Fecha de vencimiento
}

Configuracion "1" -- "0..N" Periodo : rige
Periodo "1" -- "0..N" Cuota : comprende

entity "Evento" as Evento {
  <u>Nombre</u>
  <u>Año</u>
  Importe
}

Evento "0..1" -- "0..N" Cobro : corresponde a

' ===================== Pagos =====================

entity "Pago" as Pago {
  Fecha
  Motivo de anulación [opcional]
  Fecha de anulación [opcional]
  /Anulado
  /Importe total
}

entity "Medio de Pago" as MedioPago {
  <u>Nombre</u>
}

entity "Recibo" as Recibo {
  <u>Número</u>
  Fecha de emisión
}

Obligacion "1..N" -- "0..N" Pago : se aplica a\n[Importe aplicado]
Pago "0..N" -- "1" Personal : registra\npago
Pago "0..N" -- "0..1" Personal : anula
MedioPago "0..1" -- "0..N" Pago : se abona con
Pago "1" -- "0..1" Recibo : genera

@enduml
