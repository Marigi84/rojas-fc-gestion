@startchen
title DER conceptual — Sistema de Gestión Rojas FC

' Notación Chen con cardinalidades (mín, máx):
' el par junto a cada entidad indica en cuántas ocurrencias
' de la relación participa cada ocurrencia de esa entidad.

' ===================== Personas =====================

entity "Persona" as PERSONA {
  "DNI" as P_DNI <<key>>
  "Nombre" as P_NOM
  "Apellido" as P_APE
}

entity "Alumno" as ALUMNO {
  "Fecha de nacimiento" as A_FNAC
  "Dirección" as A_DIR {
    "Domicilio" as A_DOM
    "Barrio" as A_BAR
    "Localidad" as A_LOC
  }
  "Colegio" as A_COL
  "Importe de cuota particular (opc.)" as A_IMP
  "Categoría" as A_CAT <<derived>>
  "Estado" as A_EST <<derived>>
  "Moroso" as A_MOR <<derived>>
}

entity "Responsable" as RESP {
  "Teléfono" as R_TEL
  "Contraseña (opc.)" as R_PASS
}

entity "Personal Administrativo" as PERSONAL {
  "Correo electrónico (único)" as PA_MAIL
  "Contraseña" as PA_PASS
}

PERSONA =>= o { ALUMNO, RESP, PERSONAL }

relationship "tiene como\nresponsable" as TIENE {
  "Vínculo" as T_VIN
}
ALUMNO -(1,2)- TIENE
TIENE -(1,N)- RESP

' ===================== Inscripción =====================

entity "Preinscripción" as PREINS {
  "Número" as PR_NUM <<key>>
  "Fecha" as PR_FEC
  "Estado" as PR_EST
  "Fecha de resolución (opc.)" as PR_FRES
  "Datos del alumno" as PR_DA {
    "Nombre" as PR_DA_NOM
    "Apellido" as PR_DA_APE
    "DNI" as PR_DA_DNI
    "Fecha de nacimiento" as PR_DA_FNAC
    "Domicilio" as PR_DA_DOM
    "Barrio" as PR_DA_BAR
    "Localidad" as PR_DA_LOC
    "Colegio" as PR_DA_COL
  }
  "Datos del responsable (1 a 2)" as PR_DR <<multi>> {
    "Nombre" as PR_DR_NOM
    "Apellido" as PR_DR_APE
    "DNI" as PR_DR_DNI
    "Teléfono" as PR_DR_TEL
    "Vínculo" as PR_DR_VIN
  }
}

relationship "corresponde a" as CORR_PRE {
}
PREINS -(0,1)- CORR_PRE
CORR_PRE -(0,N)- ALUMNO

relationship "revisa" as REVISA {
}
PERSONAL -(0,N)- REVISA
REVISA -(0,1)- PREINS

entity "Movimiento de Alumno" as MOV <<weak>> {
  "Fecha y hora" as M_FH <<key>>
  "Tipo" as M_TIPO
  "Observación (opc.)" as M_OBS
}

relationship "registra" as REG_MOV <<identifying>> {
}
ALUMNO -(1,N)- REG_MOV
REG_MOV =(1,1)= MOV

relationship "realiza" as REALIZA {
}
PERSONAL -(0,N)- REALIZA
REALIZA -(1,1)- MOV

' ===================== Obligaciones =====================

entity "Obligación de Pago" as OBLIG {
  "Número" as O_NUM <<key>>
  "Importe" as O_IMP
  "Saldo" as O_SAL <<derived>>
}

entity "Cuota" as CUOTA {
  "Recargo por mora (opc.)" as C_REC
  "Estado" as C_EST <<derived>>
}

entity "Matrícula" as MATRICULA {
  "Fecha de matriculación" as MA_FEC <<derived>>
}

entity "Cobro Extraordinario" as COBRO {
  "Fecha de generación" as CE_FEC
}

entity "Cobro de Indumentaria" as INDUM {
  "Tipo de prenda" as CI_PRE
  "Talle" as CI_TAL
}

OBLIG =>= d { CUOTA, MATRICULA, COBRO }
COBRO ->- INDUM

relationship "posee" as POSEE {
}
ALUMNO -(0,N)- POSEE
POSEE -(1,1)- OBLIG

relationship "origina" as ORIGINA {
}
MOV -(0,1)- ORIGINA
ORIGINA -(1,1)- MATRICULA

entity "Configuración de Cuota" as CONFIG {
  "Vigente desde" as CF_VIG <<key>>
  "Importe general" as CF_IMP
  "Porcentaje de interés" as CF_POR
}

entity "Período de Cuota" as PERIODO {
  "Período" as PE_PER <<key>>
  "Fecha de vencimiento" as PE_VTO
}

relationship "rige" as RIGE {
}
CONFIG -(0,N)- RIGE
RIGE -(1,1)- PERIODO

relationship "comprende" as COMPRENDE {
}
PERIODO -(0,N)- COMPRENDE
COMPRENDE -(1,1)- CUOTA

entity "Evento" as EVENTO {
  "Nombre" as EV_NOM <<key>>
  "Año" as EV_ANIO <<key>>
}

relationship "corresponde a" as CORR_EV {
}
EVENTO -(0,N)- CORR_EV
CORR_EV -(0,1)- COBRO

' ===================== Pagos =====================

entity "Pago" as PAGO {
  "Número de operación" as PG_NUM <<key>>
  "Fecha" as PG_FEC
  "Medio de pago (opc.)" as PG_MED
  "Anulado" as PG_ANU
  "Motivo de anulación (opc.)" as PG_MOT
  "Fecha de anulación (opc.)" as PG_FAN
  "Importe total" as PG_TOT <<derived>>
}

entity "Recibo" as RECIBO {
  "Número" as RC_NUM <<key>>
  "Fecha de emisión" as RC_FEC
}

relationship "se aplica a" as APLICA {
  "Importe aplicado" as AP_IMP
}
PAGO -(1,N)- APLICA
APLICA -(0,N)- OBLIG

relationship "registra" as REG_PAGO {
}
PERSONAL -(0,N)- REG_PAGO
REG_PAGO -(1,1)- PAGO

relationship "anula" as ANULA {
}
PERSONAL -(0,N)- ANULA
ANULA -(0,1)- PAGO

relationship "genera" as GENERA {
}
PAGO -(1,1)- GENERA
GENERA -(1,1)- RECIBO

@endchen
