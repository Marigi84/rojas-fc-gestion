@startuml
title DER conceptual — Sistema de Gestión Rojas FC

left to right direction

hide methods
hide stereotypes
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 40
skinparam ArrowColor #444444
skinparam NoteBackgroundColor #FFFDEB
skinparam NoteBorderColor #888888

entity "Preinscripción" as Preinscripcion {
  == Datos declarados del alumno ==
  Nombre
  Apellido
  DNI
  Fecha de nacimiento
  Domicilio
  Barrio
  Localidad
  Colegio
  --
  == Datos declarados del responsable (1..2) ==
  Nombre
  Apellido
  DNI
  Teléfono
  Vínculo
}

note bottom of Preinscripcion
  Pendiente de revisión.
  No representa registros definitivos
  ni genera obligaciones económicas.
end note

entity "Persona" as Persona {
  DNI
  Nombre
  Apellido
}

entity "Alumno" as Alumno {
  Fecha de nacimiento
  Colegio
  Domicilio
  Barrio
  Localidad
  Importe de cuota particular [opcional]
}

entity "Responsable" as Responsable {
  Teléfono
}

entity "Administrador" as Administrador {
}

entity "Usuario" as Usuario {
  Contraseña
}

entity "Movimiento de Alumno" as MovimientoAlumno {
  Tipo
  Fecha
  Observación
}

Persona <|-- Alumno
Persona <|-- Responsable
Persona <|-- Administrador

Persona "1" -- "0..1" Usuario : posee cuenta
Alumno "1..N" -- "1..2" Responsable : tiene como responsable\n[Vínculo]
Alumno "1" -- "1..N" MovimientoAlumno : registra

note top of Persona
  Especialización TOTAL y EXCLUSIVA:
  Alumno | Responsable | Administrador.
  Los subtipos heredan DNI, Nombre y Apellido.
end note

note right of Usuario
  Solo Responsable y Administrador
  pueden poseer Usuario.
end note

entity "Obligación de Pago" as ObligacionPago {
  Importe
}

entity "Cuota" as Cuota {
}

entity "Matrícula" as Matricula {
}

entity "Cobro Extraordinario" as CobroExtraordinario {
}

entity "Configuración de Cuota" as ConfiguracionCuota {
  Importe general
  Porcentaje de interés
  Vigente desde
}

entity "Período de Cuota" as PeriodoCuota {
  Período
  Fecha de vencimiento
}

Alumno "1" -- "0..N" ObligacionPago : posee

ObligacionPago <|-- Cuota
ObligacionPago <|-- Matricula
ObligacionPago <|-- CobroExtraordinario

ConfiguracionCuota "1" -- "0..N" PeriodoCuota : rige
PeriodoCuota "1" -- "0..N" Cuota : comprende

note top of ObligacionPago
  Especialización TOTAL y EXCLUSIVA:
  Cuota | Matrícula | Cobro Extraordinario.
  Los subtipos heredan Importe.
end note

note right of Matricula
  Primer ingreso.
  Reactivación no genera otra.
  Pago total, sin parciales.
end note

entity "Pago" as Pago {
  Fecha
  Importe total
  Medio de pago [opcional]
  Anulado
  Motivo de anulación [condicional]
}

entity "Recibo" as Recibo {
  Número
  Fecha de emisión
}

Pago "0..N" -- "1..N" ObligacionPago : se aplica a\n[Importe aplicado]
Pago "1" -- "0..1" Recibo : genera

note bottom of Pago
  Las obligaciones incluidas en un mismo Pago
  deben pertenecer al mismo Alumno.
end note

entity "Evento" as Evento {
  Nombre
  Año
}

entity "Pedido de Indumentaria" as PedidoIndumentaria {
  Tipo de prenda
  Talle
}

Evento "0..1" -- "0..N" CobroExtraordinario : origina
PedidoIndumentaria "0..1" -- "1" CobroExtraordinario : origina

note right of CobroExtraordinario
  XOR:
  exactamente un Evento
  O un Pedido de Indumentaria.
end note

@enduml
