@startuml
title DER conceptual — Sistema de Gestión Rojas FC

left to right direction

hide methods
hide stereotypes
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 90
skinparam ArrowColor #444444
skinparam NoteBackgroundColor #FFFDEB
skinparam NoteBorderColor #888888

legend top right
  <u>Subrayado</u>: identificador
  {parcial}: identificador parcial de entidad débil
  [opcional]: puede no tener valor
end legend

' ===================== Personas =====================

entity "Persona" as Persona {
  <u>DNI</u>
  Nombre
  Apellido
}

entity "Alumno" as Alumno {
  Fecha de nacimiento
  Colegio
  Domicilio
  Barrio
  Localidad
  Importe de cuota particular [opcional]
}

entity "Responsable" as Responsable {
  Teléfono
  Contraseña [opcional]
}

Persona <|-- Alumno
Persona <|-- Responsable

note top of Persona
  Especialización TOTAL y EXCLUSIVA:
  Alumno | Responsable.
end note

Alumno "1..N" -- "1..2" Responsable : tiene como\nresponsable\n[Vínculo]

' ===================== Preinscripción y movimientos =====================

entity "Preinscripción" as Preinscripcion {
  <u>Número de preinscripción</u>
  Fecha
  Estado
  Fecha de resolución [opcional]
  == Datos declarados del alumno ==
  Nombre
  Apellido
  DNI
  Fecha de nacimiento
  Domicilio
  Barrio
  Localidad
  Colegio
  == Datos declarados del responsable (1..2) ==
  Nombre
  Apellido
  DNI
  Teléfono
  Vínculo
}

Preinscripcion "0..N" -- "0..1" Alumno : corresponde a

note bottom of Preinscripcion
  Estado: Pendiente | Aprobada | Rechazada.
  Solo una preinscripción Aprobada corresponde a un Alumno
  (alta nueva o reactivación).
end note

entity "Movimiento de Alumno\n(entidad débil)" as MovimientoAlumno {
  Fecha y hora {parcial}
  Tipo
  Observación
}

Alumno "1" -- "1..N" MovimientoAlumno : registra

' ===================== Obligaciones =====================

entity "Obligación de Pago" as ObligacionPago {
  <u>Número de obligación</u>
  Importe
}

entity "Cuota" as Cuota {
  Recargo por mora [opcional]
}

entity "Cobro Extraordinario" as CobroExtraordinario {
  Fecha
}

entity "Cobro de Indumentaria" as CobroIndumentaria {
  Tipo de prenda
  Talle
}

Alumno "1" -- "0..N" ObligacionPago : posee
MovimientoAlumno "0..1" -- "0..1" ObligacionPago : origina matrícula

ObligacionPago <|-- Cuota
ObligacionPago <|-- CobroExtraordinario

CobroExtraordinario <|-- CobroIndumentaria

note top of ObligacionPago
  Especialización PARCIAL y EXCLUSIVA:
  Cuota | Cobro Extraordinario.
  La obligación originada por el Movimiento
  de Alta es la Matrícula.
  Un Alumno tiene como máximo una Cuota por Período.
end note

note bottom of CobroExtraordinario
  Todo Cobro Extraordinario corresponde a un Evento
  o es un Cobro de Indumentaria, nunca ambos ni ninguno.
end note

entity "Configuración de Cuota" as ConfiguracionCuota {
  <u>Vigente desde</u>
  Importe general
  Porcentaje de interés
}

entity "Período de Cuota" as PeriodoCuota {
  <u>Período</u>
  Fecha de vencimiento
}

ConfiguracionCuota "1" -- "0..N" PeriodoCuota : rige
PeriodoCuota "1" -- "0..N" Cuota : comprende

entity "Evento" as Evento {
  <u>Nombre</u>
  <u>Año</u>
}

Evento "0..1" -- "0..N" CobroExtraordinario : corresponde a

' ===================== Pagos =====================

entity "Pago" as Pago {
  <u>Número de operación</u>
  Fecha
  Medio de pago [opcional]
  Anulado
  Motivo de anulación [condicional]
  Fecha de anulación [condicional]
}

entity "Recibo" as Recibo {
  <u>Número</u>
  Fecha de emisión
}

ObligacionPago "1..N" -- "0..N" Pago : se aplica a\n[Importe aplicado]
Pago "1" -- "1" Recibo : genera

note bottom of Pago
  Las obligaciones incluidas en un mismo Pago
  deben pertenecer al mismo Alumno.
  Importe total = suma de Importes aplicados (derivado).
end note

@enduml
