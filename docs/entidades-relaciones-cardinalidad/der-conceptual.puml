@startchen
title DER conceptual — Sistema de Gestión Rojas FC

' ===== Personas =====
entity "Persona" as PERSONA {
  "DNI" as P_DNI <<key>>
  "Nombre" as P_NOM
  "Apellido" as P_APE
}
entity "Alumno" as ALUMNO {
  "Fecha de nacimiento" as A_FN
  "Dirección" as A_DIR
  "Categoría" as A_CAT <<derived>>
  "Estado" as A_EST <<derived>>
  "Moroso" as A_MOR <<derived>>
}
entity "Responsable" as RESPONSABLE {
  "Teléfono" as R_TEL
}
entity "Administrador" as ADMIN {
  "Email" as AD_MAIL
}
PERSONA =>= o { ALUMNO, RESPONSABLE, ADMIN }

relationship "está a cargo de" as TIENE {
  "Vínculo" as T_VINC
}
ALUMNO =N= TIENE
RESPONSABLE =M= TIENE

entity "Permanencia" as PERM <<weak>> {
  "~~Fecha de alta~~" as PM_FA
  "Fecha de baja" as PM_FB
}
relationship "registra" as REG_PERM <<identifying>> {
}
ALUMNO =1= REG_PERM
REG_PERM =N= PERM


' ===== Cuotas =====
entity "Período" as PERIODO {
  "Mes y año" as PE_MA <<key>>
  "Importe" as PE_IMP
  "Fecha de vencimiento" as PE_VEN
  "Porcentaje de interés" as PE_INT
}
entity "Cuota" as CUOTA <<weak>> {
  "Fecha de generación" as CU_FG
  "Monto a pagar" as CU_MON <<derived>>
  "Estado" as CU_EST <<derived>>
}
relationship "debe" as DEBE <<identifying>> {
}
ALUMNO -1- DEBE
DEBE =N= CUOTA
relationship "corresponde" as CORRESP <<identifying>> {
}
PERIODO -1- CORRESP
CORRESP =N= CUOTA

' ===== Eventos =====
entity "Evento" as EVENTO {
  "Nombre" as E_NOM <<key>>
  "Año" as E_ANIO <<key>>
  "Importe" as E_IMP
}
entity "Participación" as PARTIC <<weak>> {
  "Fecha de inscripción" as PA_FI
  "Saldo" as PA_SAL <<derived>>
}
relationship "se anota" as ANOTA <<identifying>> {
}
ALUMNO -1- ANOTA
ANOTA =N= PARTIC
relationship "de" as DE <<identifying>> {
}
EVENTO -1- DE
DE =N= PARTIC

' ===== Indumentaria =====
entity "Encargo" as ENCARGO <<weak>> {
  "~~Fecha y hora~~" as EN_FEC
  "Monto" as EN_MON
  "Descripción" as EN_DESC
  "Saldo" as EN_SAL <<derived>>
}
relationship "encarga" as ENCARGA <<identifying>> {
}
ALUMNO -1- ENCARGA
ENCARGA =N= ENCARGO

' ===== Pagos =====
entity "Pago" as PAGO {
  "Número de pago" as PG_NUM <<key>>
  "Fecha" as PG_FEC
  "Monto" as PG_MON
}
relationship "salda" as SALDA {
}
PAGO -N- SALDA
SALDA -1- CUOTA
relationship "abona" as ABONA_EV {
}
PAGO -N- ABONA_EV
ABONA_EV -1- PARTIC
relationship "abona" as ABONA_EN {
}
PAGO -N- ABONA_EN
ABONA_EN -1- ENCARGO

entity "Medio de pago" as MEDIO {
  "Nombre" as MP_NOM <<key>>
}
relationship "se realiza con" as REALIZA {
}
PAGO =N= REALIZA
REALIZA -1- MEDIO

entity "Recibo" as RECIBO {
  "Número de recibo" as RE_NUM <<key>>
  "Fecha de emisión" as RE_FE
  "Anulado" as RE_ANU <<derived>>
}
relationship "genera" as GENERA {
}
PAGO -1- GENERA
GENERA =1= RECIBO

' ===== Acciones del administrador =====
relationship "da de alta" as ALTA {
}
ADMIN -1- ALTA
ALTA =N= PERM

relationship "da de baja" as BAJA {
}
ADMIN -1- BAJA
BAJA -N- PERM

relationship "registra" as REG_PAGO {
}
ADMIN -1- REG_PAGO
REG_PAGO =N= PAGO

relationship "anula" as ANULA {
  "Fecha de anulación" as AN_FEC
  "Motivo" as AN_MOT
}
ADMIN -1- ANULA
ANULA -N- PAGO

relationship "configura" as CONFIGURA {
  "Fecha" as CF_FEC
}
ADMIN -1- CONFIGURA
CONFIGURA =N= PERIODO

relationship "registra" as REG_ENC {
}
ADMIN -1- REG_ENC
REG_ENC =N= ENCARGO

relationship "registra" as REG_EV {
  "Fecha" as RE_FEC
}
ADMIN -1- REG_EV
REG_EV =N= EVENTO
@endchen
